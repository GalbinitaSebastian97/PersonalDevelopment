# ==============================================================================
# AUTOSAR Adaptive Platform - Mirror Service Consumer
# ==============================================================================
# Multi-stage Dockerfile for building and running the MirrorServiceConsumer.
# ==============================================================================

# ============================================================================
# STAGE 1: BUILDER
# ============================================================================

FROM ara-base AS builder

ARG BUILD_TYPE=Debug
ENV BUILD_TYPE=${BUILD_TYPE}

ARG CI_BUILD=OFF
ENV CI_BUILD=${CI_BUILD}

WORKDIR /workspace
COPY --chown=ara:ara . .

USER ara

RUN python3 scripts/run.py MirrorServiceConsumer ${BUILD_TYPE} --clean --verbose

RUN ls -la dist/MirrorServiceConsumer/${BUILD_TYPE}/bin/ \
    && echo "Build completed successfully!"


# ============================================================================
# STAGE 2: RUNTIME
# ============================================================================

FROM ubuntu:22.04 AS runtime

LABEL maintainer="Exterior Mirror Development Team"
LABEL description="Mirror Fold Service Consumer"
LABEL version="1.0.0"
LABEL component="consumer"

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

ENV ARA_ROOT=/opt/autosar
ENV ARA_MANIFESTS_PATH=/opt/autosar/manifests
ENV ARA_LOG_PATH=/var/log/autosar
ENV LD_LIBRARY_PATH=/opt/autosar/lib:/usr/local/lib

ENV APP_NAME=MirrorServiceConsumer
ENV APP_ROLE=consumer

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libboost-log1.74.0 \
    libboost-filesystem1.74.0 \
    iproute2 \
    iputils-ping \
    tini \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd --gid 1000 ara \
    && useradd --uid 1000 --gid ara --shell /bin/bash --create-home ara

# Create directory structure
RUN mkdir -p ${ARA_ROOT}/bin \
    && mkdir -p ${ARA_ROOT}/lib \
    && mkdir -p ${ARA_MANIFESTS_PATH} \
    && mkdir -p ${ARA_LOG_PATH} \
    && chown -R ara:ara ${ARA_ROOT} \
    && chown -R ara:ara ${ARA_LOG_PATH}

# Copy artifacts from builder
ARG BUILD_TYPE=Debug

COPY --from=builder --chown=ara:ara \
    /workspace/dist/MirrorServiceConsumer/${BUILD_TYPE}/bin/MirrorServiceConsumer \
    ${ARA_ROOT}/bin/

COPY --from=builder --chown=ara:ara \
    /workspace/dist/MirrorServiceConsumer/${BUILD_TYPE}/lib/ \
    ${ARA_ROOT}/lib/

COPY --from=builder --chown=ara:ara \
    /workspace/dist/MirrorServiceConsumer/${BUILD_TYPE}/manifests/ \
    ${ARA_MANIFESTS_PATH}/

# Copy vsomeip libraries
COPY --from=builder /usr/local/lib/libvsomeip* /usr/local/lib/
RUN ldconfig

# Copy scripts
COPY --chown=ara:ara docker/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chown=ara:ara docker/scripts/healthcheck.sh /usr/local/bin/healthcheck.sh

RUN chmod +x /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/healthcheck.sh

USER ara
WORKDIR ${ARA_ROOT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["MirrorServiceConsumer"]